# Copy to .env and fill in your Binance Demo Trading API keys (never commit .env).
#
# Do NOT open demo.binance.com or testnet.binancefuture.com directly (often 404).
# Instead:
#   1. Log in at https://www.binance.com
#   2. Go to Futures → profile icon (top right) → "Demo Trading" or "Mock Trading"
#   3. Inside demo mode: profile → API Management → Create API (enable futures)
# Mobile app: Futures tab → Demo/Mock Trading → API Management

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
